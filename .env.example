# Oswald AI environment example
# Copy values into your local .env or runtime environment and fill secrets as needed.

# Optional Home Assistant gateway
# Enables /homeassistant/ws only when values are set and valid.
# Enter the same token in the HACS integration.
# Generate with: openssl rand -hex 32
HOME_ASSISTANT_AUTH_TOKEN=
HOME_ASSISTANT_LISTEN_PORT=8000

# Optional iMessage gateway
# Enables /bluebubbles/webhook only when values are set and valid.
BLUEBUBBLES_LISTEN_PORT=8090
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=

# Optional Discord gateway
# Enables Discord only when value is set.
DISCORD_TOKEN=

# MCP URL and header encryption (server descriptions are stored as plaintext model metadata)
# Generate with: openssl rand -base64 32
MCP_CONFIG_ENCRYPTION_KEY=

# LLM gateway
# Bifrost must have a Logs Store enabled for async chat and embedding routes.
# Configure the provider timeout in Bifrost; Oswald does not impose a generation timeout.
LLM_GATEWAY_URL=http://localhost:8080
LLM_GATEWAY_MODEL=
# Optional semantic channel for hybrid durable-memory recall; FTS5 remains available without it.
LLM_GATEWAY_EMBEDDING_MODEL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_VIRTUAL_KEY=

# Model limits used for prompt budgeting. Match these to the limits configured in your model gateway.
# Leave either value as 0 to use its package fallback (32768 context, 8192 output).
MODEL_CONTEXT_WINDOW=0
# Reserves foreground response capacity in prompt budgeting, not a foreground max_tokens cap.
# Private memory extraction and session compaction enforce the resolved value as max_tokens.
MODEL_MAX_OUTPUT_TOKENS=0

# Optional web providers. web.search and web.fetch are disabled when both are empty.
# Brave is primary when configured; SearXNG is the free fallback when both are set.
BRAVE_API_KEY=
SEARXNG_URL=

# Optional first-party ComfyUI image generation. Both tools are disabled when URL is empty.
COMFYUI_URL=http://comfyui:8188
COMFYUI_TEXT_TO_IMAGE_WORKFLOW=data/workflows/comfyui/text-to-image-basic.json
COMFYUI_IMAGE_TO_IMAGE_WORKFLOW=data/workflows/comfyui/image-to-image-basic.json
COMFYUI_GENERATION_TIMEOUT=2m

# Runtime behavior
WORKER_POOL_SIZE=1
LOG_LEVEL=info
